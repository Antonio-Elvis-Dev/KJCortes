# Copie para .env e preencha. Este arquivo não vai para o git.

# Senha do painel (usuário: qualquer um). OBRIGATÓRIA quando o painel estiver na internet.
KJCORTES_SENHA=

# Domínio apontado para a VPS (para o HTTPS do Caddy), ex.: cortes.seudominio.com.br
DOMINIO=

# Endereço público do painel, usado nos logins do YouTube e do TikTok, ex.: https://cortes.seudominio.com.br
KJCORTES_URL_PAINEL=

# Transcrição por API (quando transcricao.provedor = api no config.yaml)
TRANSCRICAO_API_KEY=

# IA que avalia os trechos (opcional)
ANTHROPIC_API_KEY=

# TikTok (ou coloque no config.yaml)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
