# Imagem com CUDA 12 + cuDNN 9 para transcrever na GPU NVIDIA (precisa do NVIDIA Container Toolkit no host).
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg fonts-montserrat curl \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /opt/kjcortes
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[chat,ia]"

WORKDIR /kjcortes
RUN mkdir -p dados cache saida && chown -R ubuntu:ubuntu /kjcortes
ENV HF_HOME=/kjcortes/cache/modelos \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1
USER ubuntu

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD curl -fsS http://127.0.0.1:8000/saude || exit 1
CMD ["kjcortes", "painel", "--host", "0.0.0.0", "--porta", "8000"]
